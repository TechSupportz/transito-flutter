rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Favourites: user can only touch their own docs/subcollections
    match /favourites/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Settings: user-scoped, except document "0" is public read
    match /settings/{docId}/{document=**} {
      // Public config (app settings, etc.) - readable by anyone
      allow read: if docId == "0";

      // User-specific settings - require auth and ownership
      allow read, write: if request.auth != null && request.auth.uid == docId;
    }
  }
}
